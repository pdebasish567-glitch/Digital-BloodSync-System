# ═══════════════════════════════════════════════════════════════
# Digital Blood Sync System — Environment Variables
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit the real `.env` to Git.
# ═══════════════════════════════════════════════════════════════

# ── Django ─────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True

# ── Email (SMTP) ────────────────────────────────────────────────
# Option A: Gmail SMTP (for development / small deployments)
#   Step 1: Go to Google Account → Security → 2-Step Verification → ON
#   Step 2: Go to App Passwords → Generate a 16-char app password
#   Step 3: Paste the 16-char app password below (no spaces)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Digital Blood Sync <your_gmail@gmail.com>

# Option B: SendGrid (recommended for production — comment out Option A above)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your_sendgrid_api_key_here
# DEFAULT_FROM_EMAIL=Digital Blood Sync <noreply@yourdomain.com>

# ── Twilio SMS ─────────────────────────────────────────────────
# Step 1: Sign up at https://www.twilio.com/try-twilio (free trial gives $15 credit)
# Step 2: Go to Console Dashboard → copy Account SID and Auth Token
# Step 3: Buy an Indian SMS-capable number OR use Twilio Sender ID (India requires registered sender ID)
# Step 4: For India trial: verify the recipient phone number in Twilio console first
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
# For India, you can also use an Alphanumeric Sender ID (requires Twilio registration):
# TWILIO_FROM_NUMBER=BloodSync

# ── Frontend URL (used in reset-password links) ─────────────────
FRONTEND_BASE_URL=http://localhost:5173
